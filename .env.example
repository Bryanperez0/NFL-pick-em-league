# Copy this file to ".env" for local development and fill in real values.
# Both values are found in Supabase: Project Settings > API (or "API Keys").
# Both are PUBLIC values meant for the browser. Never put the service_role /
# secret key here — it would be visible to anyone using the app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
